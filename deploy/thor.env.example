# Copy to .env on Thor; secrets are deliberately blank.
# These paths preserve existing note/audio paths when restoring the Orin snapshot.
MOSS_DATA_DIR=/data/artifacts/moss-note/20261006T062500Z-service
MOSS_MODEL_PATH=/data/models/MOSS-Transcribe-Diarize/20260902-704aa4a9
MOSS_MODEL_REVISION=704aa4a9c304e8520be88901e0d1960158ef5b15
MOSS_REQUIRE_QWEN=false
MOSS_MANAGED_MODELS=true
MOSS_MODEL_VARIANTS_FILE=/data/projects/jetson/moss_stt/deploy/model-variants.json
MOSS_MODEL_SELECTION_FILE=/data/artifacts/moss-note/20261006T062500Z-service/model-selection.json
MOSS_CUDA_DEVICE=0
MOSS_VLLM_PORT=8001
MOSS_VLLM_URL=http://127.0.0.1:8001/v1
MOSS_MODEL_NAME=moss-mtd
MOSS_APP_HOST=127.0.0.1
MOSS_APP_PORT=8000
MOSS_MAX_UPLOAD_GB=0.09
MOSS_CHUNK_SECONDS=1200
MOSS_CHUNK_OVERLAP_SECONDS=120
MOSS_MAX_COMPLETION_TOKENS=16384
MOSS_MAX_BATCHED_TOKENS=16384
MOSS_MAX_MODEL_LEN=32768
MOSS_MAX_NUM_SEQS=1
MOSS_GPU_MEMORY_UTILIZATION=0.40
MOSS_KV_CACHE_MEMORY_BYTES=8589934592
# Start conservatively on unverified hardware, then benchmark graphs/attention.
MOSS_ENFORCE_EAGER=true
MOSS_MAX_FAN_DURING_TRANSCRIPTION=false
VLLM_USE_FLASHINFER_SAMPLER=0
VLLM_MAX_AUDIO_DECODE_DURATION_S=1200
HF_HOME=/data/caches/huggingface
TORCH_HOME=/data/caches/torch
UV_CACHE_DIR=/data/caches/uv
PIP_CACHE_DIR=/data/caches/pip
XDG_CACHE_HOME=/data/caches/moss-note
TMPDIR=/data/caches/moss-note/tmp
MOSS_AUTH_USERNAME=
MOSS_AUTH_PASSWORD=
MOSS_CODEX_BINARY=/home/jetson/.local/bin/codex
MOSS_CODEX_TIMEOUT_SECONDS=1200
