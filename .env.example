# Copy to .env. GPU defaults assume two free 48 GB NVIDIA GPUs.
MOSS_CUDA_DEVICE=0
MOSS_GPU_MEMORY_UTILIZATION=0.45
MOSS_VLLM_PORT=8001
MOSS_VLLM_URL=http://127.0.0.1:8001/v1
MOSS_MODEL_NAME=moss-mtd
MOSS_APP_HOST=127.0.0.1
MOSS_APP_PORT=8000
MOSS_REQUIRE_QWEN=false
MOSS_MAX_UPLOAD_GB=5
MOSS_MAX_COMPLETION_TOKENS=65536
MOSS_MAX_BATCHED_TOKENS=131072
MOSS_CHUNK_SECONDS=5400
MOSS_BRIDGE_SECONDS=300
VLLM_USE_FLASHINFER_SAMPLER=0
VLLM_MAX_AUDIO_DECODE_DURATION_S=5400

# Optional app-level HTTP Basic authentication. Use only behind HTTPS.
MOSS_AUTH_USERNAME=
MOSS_AUTH_PASSWORD=

# Optional Codex correction: log in with ChatGPT as the app service user.
# Model and reasoning are pinned to gpt-6.1-sol / medium in the app.
MOSS_CODEX_BINARY=/home/jetson/.local/bin/codex
MOSS_CODEX_TIMEOUT_SECONDS=1200

# Legacy Qwen service settings; not used for AI correction.
QWEN_CUDA_DEVICE=1
QWEN_GPU_MEMORY_UTILIZATION=0.90
QWEN_VLLM_PORT=8002
QWEN_VLLM_URL=http://127.0.0.1:8002/v1
QWEN_MODEL_NAME=qwen3.8-27b
QWEN_MAX_MODEL_LEN=32768
QWEN_MAX_NUM_SEQS=2
